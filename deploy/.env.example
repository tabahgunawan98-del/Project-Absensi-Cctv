# Non-secret deployment configuration only. Never put credentials or RTSP URLs here.
ABSENSI_HOSTNAME=absensi.office.local
ABSENSI_BIND_ADDRESS=127.0.0.1
ABSENSI_TLS_CERT=/etc/absensi/tls/tls.crt
ABSENSI_TLS_KEY=/etc/absensi/tls/tls.key
VAULT_TLS_CERT=/etc/absensi/tls/vault.crt
VAULT_TLS_KEY=/etc/absensi/tls/vault.key
ABSENSI_INTERNAL_CA=/etc/absensi/tls/ca.crt
ABSENSI_ATTESTATION_FILE=/etc/absensi/at-rest.json
ABSENSI_DATA_DIR=/var/lib/absensi
ABSENSI_BACKUP_DIR=/var/backups/absensi
ABSENSI_OIDC_ISSUER=https://absensi.office.local/realms/absensi
ABSENSI_OIDC_AUDIENCE=absensi-api
ABSENSI_JWKS_URI=https://absensi.office.local/realms/absensi/protocol/openid-connect/certs
ABSENSI_RTSP_SECRET_PATH=secret/data/absensi/rtsp
ABSENSI_MANIFEST_KEY_PATH=secret/data/absensi/backup
ABSENSI_DEDUPE_WINDOW_SECONDS=10
ABSENSI_RAW_RETENTION_DAYS=30
ABSENSI_PROCESSED_RETENTION_DAYS=90
ABSENSI_RATE_LIMIT_PER_MINUTE=100
ABSENSI_CLOCK_SKEW_SECONDS=30
ABSENSI_GRACE_PERIOD_MINUTES=15
KEYCLOAK_DB_USER_FILE=/etc/absensi/secrets/keycloak-db-user
KEYCLOAK_DB_PASSWORD_FILE=/etc/absensi/secrets/keycloak-db-password
KEYCLOAK_ADMIN_USER_FILE=/etc/absensi/secrets/keycloak-admin-user
KEYCLOAK_ADMIN_PASSWORD_FILE=/etc/absensi/secrets/keycloak-admin-password
VAULT_APP_TOKEN_FILE=/etc/absensi/secrets/vault-app-token
OIDC_CLIENT_SECRET_FILE=/etc/absensi/secrets/oidc-client-secret
OAUTH_COOKIE_SECRET_FILE=/etc/absensi/secrets/oauth-cookie-secret
